# =============================================================================
# SEWT Group — variables d'environnement
# =============================================================================
# Copier ce fichier en `.env.local` (ne JAMAIS committer la version réelle).

# Public — exposé au client. URL canonique du site, utilisée pour metadata,
# sitemap, OpenGraph, schema.org.
NEXT_PUBLIC_SITE_URL=https://sewt-group.ma

# Server-only — secret du webhook ERP (POST /api/webhook/projects).
# Générer avec : openssl rand -hex 32  (ou n'importe quel CSPRNG)
# Renvoie 503 sur le webhook si non défini.
ERP_WEBHOOK_SECRET=your_secure_token_here

# Server-only — contact destination. Receives a JSON POST with an
# Authorization: Bearer header. Must use HTTPS in production.
CONTACT_WEBHOOK_URL=https://your-contact-endpoint.example/api/leads
CONTACT_WEBHOOK_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Server-only — Upstash Redis REST credentials for shared serverless throttling.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_your_upstash_rest_token
